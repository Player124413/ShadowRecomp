<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- Vulkan (Dawn's backend) and OpenGL ES 3.1 fallback; both imply ETC2 texture support. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00400000" android:required="false" />

    <!-- Touch screen and gamepads are both supported: the overlay hides itself when a controller is used. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Vibration for the touch controls' haptics -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Bluetooth controllers -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:theme="@style/ShadowTheme">

        <!-- The launcher comes first: import the player's own disc image, choose the graphics preset, play. -->
        <activity
            android:name=".LauncherActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:screenOrientation="userLandscape"
            android:configChanges="layoutDirection|locale|fontScale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The game itself: SDL3's SDLActivity with Aurora's surface (dev.shadowrecomp.ShadowActivity). -->
        <activity
            android:name=".ShadowActivity"
            android:label="@string/app_name"
            android:exported="false"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:resizeableActivity="false"
            android:preferMinimalPostProcessing="true"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>
        <!-- Hands the log to whichever app the player picks in the share sheet (LogSharing.java). Not exported: the
             read permission is granted per intent, only to that app. -->
        <provider
            android:name=".LogProvider"
            android:authorities="dev.shadowrecomp.logs"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
