# Gradle
.gradle/
build/
app/build/
local.properties

# Native libraries are build outputs (libmain.so + libadrenotools hooks), copied in by
# tools/android/build.sh or the CI workflow.
app/src/main/jniLibs/

# Bundled Turnip drivers are fetched at build time (tools/android/fetch-drivers.sh).
app/src/main/assets/bundled_driver/*.so

# Signing material must never be committed.
*.jks
*.keystore
